# stub answers locally and does not call a paid model.
# Set to openai to use a live model through the same reasoning loop.
LLM_PROVIDER=stub

# Read when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Tool rounds before the loop must generate an answer, or return an error.
MAX_REASONING_STEPS=4
ON_STEP_LIMIT=generate

LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_MS=200

# Tenure is measured against this date so answers stay repeatable.
AS_OF_DATE=2026-10-29

HOST=127.0.0.1
PORT=4001

# Optional label returned with every answer. Defaults to the process id.
# Set a different value on each copy when you run more than one agent.
AGENT_INSTANCE=
