# stub answers locally and does not call a paid model.
# Set to openai to use a live model through the same reasoning loop.
LLM_PROVIDER=stub

# Read when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google AI Studio key. When set, the model menu includes Gemini 3.8 Flash.
GEMINI_API_KEY=

# Local Ollama server. When set, the model menu lists models that support tool calling.
# Example: http://192.168.50.252:11434
OLLAMA_BASE_URL=

# User or service-account key from Cursor Dashboard → API Keys.
# When this is set, the model menu lists the models this key can run.
# https://cursor.com/dashboard/integrations
CURSOR_API_KEY=

# Tool rounds before the loop must generate an answer, or return an error.
MAX_REASONING_STEPS=4
ON_STEP_LIMIT=generate

LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_MS=200

# After generation, judge the answer the same way the offline eval does, and revise it when the judge fails it.
# The stub uses the figure-and-name rules. Off by default. The judge is another model call, and so is each revision.
ONLINE_EVAL=0
ONLINE_EVAL_MAX_RETRIES=1

# Tenure is measured against this date so answers stay repeatable.
AS_OF_DATE=2026-10-29

HOST=127.0.0.1
PORT=4001

# Optional label returned with every answer. Defaults to the process id.
# Set a different value on each copy when you run more than one agent.
AGENT_INSTANCE=
